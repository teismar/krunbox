# krunbox-python -- Lightweight Python Data & ML MicroVM Image
# Based on localhost/krunbox-base:latest (Debian Bookworm + OpenSSH + non-root vscode)

FROM localhost/krunbox-base:latest

ARG USERNAME=vscode
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install Python 3, pip, venv and essential dev headers
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev \
        git curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Copy high-performance uv / uvx binaries from Astral uv image
COPY --from=ghcr.io/astral-sh/uv:python3.12-bookworm-slim /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# 3. Create persistent Python virtual environment in /opt/venv
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir \
        pandas numpy scipy scikit-learn matplotlib jupyter requests \
    && chown -R ${USERNAME}:${USERNAME} /opt/venv

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:/home/vscode/.local/bin:${PATH}"
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Configure environment for all login and non-login shells (including SSH remote commands)
RUN printf '%s\n' \
    'export VIRTUAL_ENV=/opt/venv' \
    'export PATH="/opt/venv/bin:/home/vscode/.local/bin:$PATH"' \
    'export PIP_BREAK_SYSTEM_PACKAGES=1' \
    > /etc/profile.d/krunbox-python.sh \
    && chmod 0644 /etc/profile.d/krunbox-python.sh \
    && printf '%s\n' \
    'PATH="/opt/venv/bin:/home/vscode/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' \
    'VIRTUAL_ENV="/opt/venv"' \
    >> /etc/environment \
    && printf '\nexport PATH="/opt/venv/bin:/home/vscode/.local/bin:$PATH"\nexport VIRTUAL_ENV=/opt/venv\n' \
    >> /etc/bash.bashrc

USER root
WORKDIR /workspace

# Retain base entrypoint for OpenSSH server initialization on port 2222
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
